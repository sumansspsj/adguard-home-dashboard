# AdGuard Home connection settings
AGH_HOST=http://127.0.0.1:3000
AGH_USERNAME=admin
AGH_PASSWORD=your_password_here

# Dashboard server port
PORT=8080

# Google Gemini AI (optional — AI features disabled if not set)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# CORS origins — comma-separated list of allowed origins, or leave empty for same-origin only
# Example: CORS_ORIGINS=http://192.168.1.10:8080,http://localhost:8080
CORS_ORIGINS=

# Trust proxy — set to 1 if running behind nginx/caddy/traefik; 0 for direct exposure
TRUST_PROXY=0
